// WattPilot Database Schema
// Target: V1 MVP
// Designed with V1.5 (Tibber) extension in mind.
// V2 smart-home devices should be introduced by refactoring rather than premature abstraction.

Enum user_status {
  ACTIVE
  INACTIVE
}

Enum ev_status {
  ACTIVE
  INACTIVE
}

Enum price_provider {
  HVA_KOSTER_STROMMEN
  TIBBER
}

Enum charging_plan_status {
  SUCCEEDED
  FAILED
}

Enum charging_schedule_status {
  CREATED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

Enum charging_session_status {
  STARTED
  COMPLETED
  FAILED
  CANCELLED
}

Table users {
  id bigint [pk, increment]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  name varchar(100) [not null]
  default_price_area varchar(20) [not null, note: 'Default Norwegian bidding zone, e.g. NO1-NO5']
  status user_status [not null, default: 'ACTIVE']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `default_price_area IN ('NO1', 'NO2', 'NO3', 'NO4', 'NO5')` [name: 'user_default_price_area_valid']
  }
}

Table refresh_tokens {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  token_hash varchar(255) [not null, unique, note: 'Store only a one-way hash of the refresh token']
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]

  Indexes {
    user_id
    expires_at
  }

  checks {
    `expires_at > created_at` [name: 'refresh_token_expiry_valid']
  }
}

Table evs {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  name varchar(100) [not null, note: 'User-defined EV name']
  manufacturer varchar(100) [not null]
  model varchar(100) [not null]
  battery_capacity_kwh decimal(8,2) [not null]
  max_ac_charging_power_kw decimal(8,2) [not null]
  default_charger_power_kw decimal(8,2) [not null]
  status ev_status [not null, default: 'ACTIVE']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    user_id
  }

  checks {
    `battery_capacity_kwh > 0` [name: 'ev_battery_capacity_positive']
    `max_ac_charging_power_kw > 0 AND max_ac_charging_power_kw <= 22` [name: 'ev_max_ac_charging_power_valid']
    `default_charger_power_kw > 0 AND default_charger_power_kw <= 22` [name: 'ev_default_charger_power_valid']
  }
}

Table electricity_prices {
  id bigint [pk, increment]
  provider price_provider [not null, default: 'HVA_KOSTER_STROMMEN']
  price_area varchar(20) [not null, note: 'Norwegian bidding zone, e.g. NO1-NO5']
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  price_per_kwh decimal(12,6) [not null]
  currency varchar(3) [not null, default: 'NOK']
  fetched_at timestamptz [not null]

  Indexes {
    (provider, price_area, starts_at) [unique]
    (price_area, starts_at)
  }

  checks {
    `ends_at > starts_at` [name: 'electricity_price_time_range_valid']
    `price_area IN ('NO1', 'NO2', 'NO3', 'NO4', 'NO5')` [name: 'electricity_price_area_valid']
  }
}

// charging_plans stores the result of a single optimization attempt (SUCCEEDED or FAILED).
// It is not an execution-state table: reservation and execution lifecycle
// (confirm, cancel, execute) is owned entirely by charging_schedules.
Table charging_plans {
  id bigint [pk, increment]
  ev_id bigint [not null, ref: > evs.id]

  current_battery_percent decimal(5,2) [not null]
  target_battery_percent decimal(5,2) [not null]
  price_area varchar(20) [not null, note: 'Price area snapshot used for this charging plan']
  earliest_start_at timestamptz [not null, note: 'Defaults to plan creation time when omitted by the client']
  required_completion_at timestamptz [not null]

  // EV snapshot used by the optimizer so past plans remain reproducible
  ev_name varchar(100) [not null]
  ev_manufacturer varchar(100) [not null]
  ev_model varchar(100) [not null]
  battery_capacity_kwh decimal(8,2) [not null]
  max_ac_charging_power_kw decimal(8,2) [not null]
  default_charger_power_kw decimal(8,2) [not null]

  calculated_energy_kwh decimal(8,2)
  effective_charging_power_kw decimal(8,2)
  estimated_duration_minutes int

  recommended_start_at timestamptz
  recommended_end_at timestamptz
  expected_energy_kwh decimal(8,2)
  estimated_cost_nok decimal(12,4)
  baseline_cost_nok decimal(12,4)
  expected_savings_nok decimal(12,4)

  status charging_plan_status [not null, note: 'Optimization result only. SUCCEEDED requires the recommendation fields above; FAILED means a valid request could not produce a feasible plan.']
  failure_reason varchar(500) [note: 'Populated when status is FAILED']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    ev_id
    (status, required_completion_at)
  }

  checks {
    `current_battery_percent >= 0 AND current_battery_percent <= 100` [name: 'charging_plan_current_battery_valid']
    `target_battery_percent > 0 AND target_battery_percent <= 100` [name: 'charging_plan_target_battery_valid']
    `target_battery_percent > current_battery_percent` [name: 'charging_plan_battery_range_valid']
    `price_area IN ('NO1', 'NO2', 'NO3', 'NO4', 'NO5')` [name: 'charging_plan_price_area_valid']
    `required_completion_at > earliest_start_at` [name: 'charging_plan_window_valid']
    `battery_capacity_kwh > 0` [name: 'charging_plan_battery_capacity_positive']
    `max_ac_charging_power_kw > 0` [name: 'charging_plan_max_ac_power_positive']
    `default_charger_power_kw > 0` [name: 'charging_plan_charger_power_positive']
    `calculated_energy_kwh IS NULL OR calculated_energy_kwh >= 0` [name: 'charging_plan_energy_non_negative']
    `effective_charging_power_kw IS NULL OR effective_charging_power_kw > 0` [name: 'charging_plan_effective_power_positive']
    `estimated_duration_minutes IS NULL OR estimated_duration_minutes > 0` [name: 'charging_plan_duration_positive']
    `recommended_end_at IS NULL OR recommended_start_at IS NULL OR recommended_end_at > recommended_start_at` [name: 'charging_plan_recommended_range_valid']
    `expected_energy_kwh IS NULL OR expected_energy_kwh >= 0` [name: 'charging_plan_expected_energy_non_negative']
    `status <> 'SUCCEEDED' OR (recommended_start_at IS NOT NULL AND recommended_end_at IS NOT NULL AND expected_energy_kwh IS NOT NULL AND estimated_cost_nok IS NOT NULL AND baseline_cost_nok IS NOT NULL AND expected_savings_nok IS NOT NULL)` [name: 'charging_plan_succeeded_fields_present']
    `status <> 'FAILED' OR failure_reason IS NOT NULL` [name: 'charging_plan_failed_reason_present']
  }
}

Table charging_plan_slots {
  id bigint [pk, increment]
  charging_plan_id bigint [not null, ref: > charging_plans.id]
  electricity_price_id bigint [not null, ref: > electricity_prices.id]

  slot_start_at timestamptz [not null]
  slot_end_at timestamptz [not null]
  planned_energy_kwh decimal(8,2) [not null]
  expected_cost_nok decimal(12,4) [not null]
  sequence_no int [not null]

  Indexes {
    charging_plan_id
    (charging_plan_id, sequence_no) [unique]
  }

  checks {
    `slot_end_at > slot_start_at` [name: 'charging_plan_slot_time_range_valid']
    `planned_energy_kwh > 0` [name: 'charging_plan_slot_energy_positive']
    `sequence_no > 0` [name: 'charging_plan_slot_sequence_positive']
  }
}

Table charging_schedules {
  id bigint [pk, increment]
  charging_plan_id bigint [not null, ref: > charging_plans.id]

  scheduled_start_at timestamptz [not null]
  scheduled_end_at timestamptz [not null]
  expected_energy_kwh decimal(8,2) [not null]
  estimated_cost_nok decimal(12,4) [not null]

  status charging_schedule_status [not null, default: 'CREATED']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    charging_plan_id [unique]
    (status, scheduled_start_at)
  }

  checks {
    `scheduled_end_at > scheduled_start_at` [name: 'charging_schedule_time_range_valid']
    `expected_energy_kwh > 0` [name: 'charging_schedule_energy_positive']
  }
}

Table charging_schedule_slots {
  id bigint [pk, increment]
  charging_schedule_id bigint [not null, ref: > charging_schedules.id]
  electricity_price_id bigint [not null, ref: > electricity_prices.id]

  slot_start_at timestamptz [not null]
  slot_end_at timestamptz [not null]
  planned_energy_kwh decimal(8,2) [not null]
  expected_cost_nok decimal(12,4) [not null]
  sequence_no int [not null]

  Indexes {
    charging_schedule_id
    (charging_schedule_id, sequence_no) [unique]
  }

  checks {
    `slot_end_at > slot_start_at` [name: 'charging_schedule_slot_time_range_valid']
    `planned_energy_kwh > 0` [name: 'charging_schedule_slot_energy_positive']
    `sequence_no > 0` [name: 'charging_schedule_slot_sequence_positive']
  }
}

Table charging_sessions {
  id bigint [pk, increment]
  charging_schedule_id bigint [not null, ref: > charging_schedules.id]

  started_at timestamptz
  completed_at timestamptz
  actual_energy_kwh decimal(8,2)
  actual_cost_nok decimal(12,4)

  baseline_cost_nok decimal(12,4) [note: 'Estimated cost if charging started immediately']
  optimized_cost_nok decimal(12,4)
  estimated_savings_nok decimal(12,4)

  status charging_session_status [not null]
  failure_reason varchar(500)

  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    charging_schedule_id
    started_at
  }

  checks {
    `completed_at IS NULL OR started_at IS NULL OR completed_at >= started_at` [name: 'charging_session_time_range_valid']
    `actual_energy_kwh IS NULL OR actual_energy_kwh >= 0` [name: 'charging_session_energy_non_negative']
  }
}

// -------------------------
// V1.5 candidate extension
// -------------------------
// Add only when vehicle master data or Tibber integration is implemented.
//
// Table vehicle_models {
//   id bigint [pk, increment]
//   manufacturer varchar(100) [not null]
//   model varchar(100) [not null]
//   variant varchar(100)
//   model_year int
//   battery_capacity_kwh decimal(8,2) [not null]
//   max_ac_charging_power_kw decimal(8,2) [not null]
//   created_at timestamptz [not null]
//   updated_at timestamptz [not null]
//
//   Indexes {
//     (manufacturer, model, variant, model_year) [unique]
//   }
//
//   checks {
//     `battery_capacity_kwh > 0` [name: 'vehicle_model_battery_capacity_positive']
//     `max_ac_charging_power_kw > 0` [name: 'vehicle_model_charging_power_positive']
//   }
// }
//
// Add a nullable reference to evs:
// vehicle_model_id bigint [ref: > vehicle_models.id]
//
// Keep evs.battery_capacity_kwh, evs.max_ac_charging_power_kw, and
// evs.default_charger_power_kw as the V1 inputs/snapshots used by the optimizer.
// This supports manual V1 entries and later vehicle-model presets.
//
// Table integration_accounts {
//   id bigint [pk, increment]
//   user_id bigint [not null]
//   provider varchar(50) [not null, note: 'e.g. TIBBER']
//   external_account_id varchar(255)
//   access_token_encrypted text
//   refresh_token_encrypted text
//   token_expires_at timestamptz
//   created_at timestamptz [not null]
//   updated_at timestamptz [not null]
//
//   Indexes {
//     (user_id, provider) [unique]
//   }
// }
//
// Ref: integration_accounts.user_id > users.id
//
// Tibber prices may be personalized per account. Do not store personalized
// prices under the V1 public-price unique key alone. When implemented, either
// associate them with integration_account_id using a separate table or add an
// account-scoped key with PostgreSQL partial unique indexes.

// -------------------------
// V2 refactoring direction
// -------------------------
// Manufacturer OAuth connections should be stored separately from evs.
//
// Table vehicle_connections {
//   id bigint [pk, increment]
//   user_id bigint [not null]
//   ev_id bigint [not null]
//   provider varchar(50) [not null, note: 'e.g. TESLA, BMW, HYUNDAI']
//   external_vehicle_id varchar(255) [not null]
//   access_token_encrypted text
//   refresh_token_encrypted text
//   token_expires_at timestamptz
//   connection_status varchar(50) [not null]
//   created_at timestamptz [not null]
//   updated_at timestamptz [not null]
//
//   Indexes {
//     (user_id, provider, external_vehicle_id) [unique]
//     ev_id
//   }
// }
//
// Ref: vehicle_connections.user_id > users.id
// Ref: vehicle_connections.ev_id > evs.id
//
// When smart-home devices are actually introduced,
// consider extracting EV-specific ownership into a generalized device model:
//
// devices
//   ├── ev_device_details
//   ├── washing_machine_details
//   └── dishwasher_details
//
// At that point, charging_plans/schedules can evolve into
// generalized energy_jobs/energy_schedules.
// Do not introduce this abstraction in V1 unless requirements demand it.
