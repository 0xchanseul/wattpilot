# Copy to `deploy/azure/.env` ON THE VM and fill in real values. `.env` is git-ignored
# and must never be committed. See docs/deployment.md, "Temporary Test Environment (Azure)".

# Container image built locally and pushed to GHCR. Lowercase the owner.
BACKEND_IMAGE=ghcr.io/<github-owner>/wattpilot-backend:latest

# --- Azure Database for PostgreSQL Flexible Server ---
POSTGRES_HOST=<server-name>.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=wattpilot
POSTGRES_USER=<admin-user>
POSTGRES_PASSWORD=<admin-password>

# --- Auth ---
# Base64-encoded random value of at least 32 bytes: openssl rand -base64 32
JWT_SECRET=<base64-encoded-32-byte-random-value>

# --- Browser origin allowed to call this API (local Vite dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional scheduler overrides (defaults live in application.yml) ---
# PRICE_COLLECTION_ENABLED=true
# CHARGING_EXECUTION_ENABLED=true
