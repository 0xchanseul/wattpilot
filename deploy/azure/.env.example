# Copy this ON THE VM and fill in real values, then point docker-compose.yml's `env_file` at it.
# On the current production VM this file actually lives at `/etc/wattpilot/wattpilot.env`, not
# next to docker-compose.yml — check where it really is before assuming the default path. Never
# commit the real file. See docs/deployment.md, "Production Architecture (Azure)".

# Container image built locally and pushed to GHCR. Lowercase the owner.
BACKEND_IMAGE=ghcr.io/<github-owner>/wattpilot-backend:latest

# --- Azure Database for PostgreSQL Flexible Server ---
POSTGRES_HOST=<server-name>.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=wattpilot
POSTGRES_USER=<admin-user>
POSTGRES_PASSWORD=<admin-password>

# --- Auth ---
# Base64-encoded random value of at least 32 bytes: openssl rand -base64 32
JWT_SECRET=<base64-encoded-32-byte-random-value>

# --- Browser origins allowed to call this API ---
# The production frontend is served from the same origin (nginx proxies /api/ to this
# container), so same-origin calls never need CORS at all. This only matters for a browser
# client calling the API from a different origin (e.g. testing a local frontend against prod).
CORS_ALLOWED_ORIGINS=https://wattpilot.dev,https://www.wattpilot.dev

# --- Optional scheduler overrides (defaults live in application.yml) ---
# PRICE_COLLECTION_ENABLED=true
# CHARGING_EXECUTION_ENABLED=true

# --- Smartcar vehicle telemetry (optional, V1.5) ---
# Read-only real-vehicle battery/charging status, linked per EV. OFF unless SMARTCAR_ENABLED=true.
# Register https://www.wattpilot.dev/vehicle-connections/callback as the redirect URI in the
# Smartcar dashboard app. Charging execution stays on Mock Charging regardless of this feature.
# SMARTCAR_ENABLED=true
# SMARTCAR_CLIENT_ID=<smartcar-client-id>
# SMARTCAR_CLIENT_SECRET=<smartcar-client-secret>
# SMARTCAR_APPLICATION_ID=<smartcar-application-id>
# SMARTCAR_REDIRECT_URI=https://www.wattpilot.dev/vehicle-connections/callback
# "simulated" uses vehicles created in the Smartcar dashboard's Vehicle Simulator; "live" needs a
# real vehicle account, so use it only for a deliberate live test.
# SMARTCAR_MODE=simulated

# --- Demo login (optional) ---
# Lets a visitor try the service without signing up: each demo login creates a temporary account
# holding copies of the template account's EVs and finished charging history, deleted automatically
# after DEMO_TTL. OFF unless
# DEMO_ENABLED=true. The template is an existing account (never put its password here); see
# docs/deployment.md, "Demo login (optional)", for how to prepare it.
# DEMO_ENABLED=true
# DEMO_TEMPLATE_EMAIL=<template-account-email>
# DEMO_TTL=24h
# DEMO_MAX_ACTIVE_ACCOUNTS=200
# DEMO_CLEANUP_CRON=0 0 * * * *
# DEMO_CLEANUP_BATCH_SIZE=200
