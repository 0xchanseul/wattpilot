# Copy this file to `.env` in the repository root and adjust the values for your
# local environment. `.env` is git-ignored and must never contain production secrets.
#
# This single file is shared by:
#   - the local PostgreSQL container:
#       docker compose --env-file .env -f docker/postgres/docker-compose.yml up -d
#   - the Spring Boot backend (local profile), via spring.config.import in
#     backend/src/main/resources/application-local.yml

POSTGRES_DB=wattpilot
POSTGRES_USER=wattpilot
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# HS256 signing key for JWT access tokens.
# Must be a Base64-encoded random value of at least 32 bytes (256 bits).
# Generate one with: openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-encoded-32-byte-random-value

# --- Electricity price collection (optional overrides) ---
# The scheduler that fetches Norwegian next-day prices from the public Hva koster
# strømmen API. It is OFF by default in the local profile so development and tests
# never call the real API. All values below have working defaults in application.yml;
# uncomment only to override.
#
# PRICE_COLLECTION_ENABLED=false
# PRICE_COLLECTION_CRON=0 15 13-22 * * *
# PRICE_COLLECTION_ZONE=Europe/Oslo
# HVA_KOSTER_STROMMEN_BASE_URL=https://www.hvakosterstrommen.no/api/v1
# HVA_KOSTER_STROMMEN_CONNECT_TIMEOUT=3s
# HVA_KOSTER_STROMMEN_READ_TIMEOUT=5s

# --- Mock Charging execution (optional overrides) ---
# The 1-minute scheduler that drives confirmed reservations through Mock Charging. It is OFF by
# default in the local profile; enable it to see schedules move WAITING -> IN_PROGRESS -> COMPLETED.
#
# CHARGING_EXECUTION_ENABLED=true
#
# To demo a failed charge, map a charging-schedule id (use a real id from your DB) to the failure
# the mock adapter should simulate. Empty by default, so every charge succeeds. Codes:
#   CHARGER_UNAVAILABLE | VEHICLE_DISCONNECTED | START_REJECTED  - start-phase failure, no retry
#   CHARGING_INTERRUPTED  - completion-phase failure (schedule reaches IN_PROGRESS first)
#   SYSTEM_ERROR          - adapter throws on start; bounded retry runs, then FAILED(SYSTEM_ERROR)
#
# wattpilot.charging.execution.mock.failures.12=CHARGER_UNAVAILABLE
# wattpilot.charging.execution.mock.failures.15=SYSTEM_ERROR
