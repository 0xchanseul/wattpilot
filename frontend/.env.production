# Base URL of the WattPilot backend REST API for the production build.
# Vite bakes this into the JS bundle at `npm run build` time (mode=production), so it must already
# be correct before building. Same origin as the frontend: nginx serves the built app and proxies
# /api/ to the backend container (see docs/deployment.md, "Production Architecture (Azure)").
# Must stay absolute (scheme + host) because api-client.ts's buildUrl() does
# `new URL(API_BASE_URL + path)` with no base argument, which throws on a relative string.
VITE_API_BASE_URL=https://www.wattpilot.dev/api/v1
