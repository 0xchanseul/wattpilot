# Base URL of the WattPilot backend REST API for the production build.
# Vite bakes this into the JS bundle at `npm run build` time (mode=production), so it must already
# be correct before building for S3/CloudFront — it cannot be changed by editing server config
# after deployment. Replace with the real API domain once it is provisioned (see
# docs/deployment.md, "Production Architecture" — ALB in front of ECS Fargate).
VITE_API_BASE_URL=https://api.wattpilot.example/api/v1
